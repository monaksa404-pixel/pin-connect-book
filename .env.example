# Copy this file to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram alerts (optional — if empty, alerts are skipped and the site still works)
# Create a bot with @BotFather, add it to your group, then get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
